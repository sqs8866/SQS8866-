.container{
  position: relative;
  width: 100vw;
  height: 100vh;
}
.btnContainer{
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-around;
}
.btnClass {
  flex: 1;
  margin-left: 5px;
}
.section{
  position: fixed;
  top: 50px;
  left: 10px;
  width: 100vw;
  height: 50px;
  display: flex;
  align-items: center;
}

canvas {
  position: fixed;
  top: 120px;
  left: 0;
  z-index: 999;
}