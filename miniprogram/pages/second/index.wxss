/* pages/fireworks/fireworks.wxss */
page {
  background: #000000;
}

.fullscreen-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #000000;
}

.fireworks-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 顶部控制栏 */
.top-controls {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-button {
  display: flex;
  align-items: center;
  color: white;
  font-size: 32rpx;
  padding: 20rpx 30rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50rpx;
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255,255,255,0.2);
}

.back-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.control-buttons {
  display: flex;
  gap: 20rpx;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255,255,255,0.3);
  transition: all 0.3s;
}

.control-btn.play {
  background: rgba(7, 193, 96, 0.8);
}

.control-btn.pause {
  background: rgba(255, 107, 107, 0.8);
}

.btn-icon {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

/* 底部提示 */
.bottom-hint {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  z-index: 5;
  text-align: center;
}

.hint-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  background: rgba(0, 0, 0, 0.5);
  padding: 15rpx 30rpx;
  border-radius: 50rpx;
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255,255,255,0.1);
}

/* 调试信息 */
.debug-info {
  position: absolute;
  top: 120rpx;
  left: 30rpx;
  z-index: 5;
  background: rgba(0, 0, 0, 0.7);
  padding: 20rpx;
  border-radius: 10rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.1);
}

.debug-text {
  display: block;
  color: #00FF00;
  font-size: 24rpx;
  font-family: monospace;
  margin-bottom: 8rpx;
}

.debug-text:last-child {
  margin-bottom: 0;
}

/* 确保覆盖整个屏幕 */
.fullscreen-container, .fireworks-canvas {
  width: 100vw;
  height: 100vh;
}